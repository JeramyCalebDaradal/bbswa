server {
    server_tokens off;
   
    listen 80;
    server_name bbsdev.qzz.io;

    location /.well-known/acme-challenge/ {
        root /usr/share/nginx/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
server {
    server_tokens off;
    listen 443 ssl;
    server_name bbsdev.qzz.io;
    
    client_max_body_size 60m;

    ssl_certificate /etc/letsencrypt/live/bbsdev.qzz.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbsdev.qzz.io/privkey.pem;

location /uploads/ {
    alias /usr/share/nginx/html/uploads/;
}

    location /api/v1/ {
        proxy_pass http://bbsbackend:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

location /api/ {
    rewrite ^/api/(.*)$ /api/v1/$1 break;

    proxy_pass http://bbsbackend:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

    location / {
        proxy_pass http://bbsfrontend:80;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
